datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Stop {
  id        String   @id @default(uuid())
  stopCode  String   @unique
  name      String
  lat       Float
  lon       Float
  zone      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fromSegments SegmentTravelTime[] @relation("FromStopTravelTime")
  toSegments   SegmentTravelTime[] @relation("ToStopTravelTime")

  routeStops RouteStop[]

  @@index([lat, lon])
  @@index([name])
}

model BusRoute {
  id              String   @id @default(uuid())
  routeNumber     String   @unique
  longName        String
  busType         String   @default("Standard")
  totalDistanceKm Float
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  routeStops          RouteStop[]
  travelTimeSegments  SegmentTravelTime[]
  crowdednessSegments SegmentCrowdedness[]

  @@index([routeNumber])
}

model RouteStop {
  id           String @id @default(uuid())
  routeId      String
  stopId       String
  stopSequence Int

  route BusRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  stop  Stop     @relation(fields: [stopId], references: [id], onDelete: Cascade)

  @@unique([routeId, stopSequence])
  @@index([routeId])
  @@index([stopId])
}

model SegmentTravelTime {
  id                String   @id @default(uuid())
  routeId           String
  fromStopId        String
  toStopId          String
  hourOfDay         Int
  dayOfWeek         Int
  medianDurationSec Float
  p90DurationSec    Float
  trafficDelaySec   Float
  sampleCount       Int
  confidenceScore   Float
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  route    BusRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  fromStop Stop     @relation("FromStopTravelTime", fields: [fromStopId], references: [id], onDelete: Cascade)
  toStop   Stop     @relation("ToStopTravelTime", fields: [toStopId], references: [id], onDelete: Cascade)

  @@index([routeId, hourOfDay, dayOfWeek])
  @@index([fromStopId, toStopId])
}

model SegmentCrowdedness {
  id                 String   @id @default(uuid())
  routeId            String
  fromStopId         String
  toStopId           String
  hourOfDay          Int
  dayOfWeek          Int
  occupancyRatio     Float
  crowdingCategory   String
  standingLikelihood String
  confidenceScore    Float
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  route BusRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@index([routeId, hourOfDay, dayOfWeek])
  @@index([fromStopId, toStopId])
}

model JourneySearchLog {
  id               String   @id @default(uuid())
  originQuery      String
  destinationQuery String
  optimizePreference String @default("balanced")
  createdAt        DateTime @default(now())
}

model VehiclePosition {
  id            String   @id @default(uuid())
  vehicleId     String
  tripId        String?
  routeId       String?
  lat           Float
  lon           Float
  bearing       Float?
  speed         Float?
  timestamp     DateTime
  recordedAt    DateTime @default(now())
  currentStopSequence Int?
  stopId        String?

  @@index([vehicleId])
  @@index([routeId])
  @@index([timestamp])
  @@index([lat, lon])
}
